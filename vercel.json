{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/u/:username", "destination": "/u" }
  ],
  "redirects": [
    { "source": "/worldcup", "destination": "/categories", "permanent": true },
    { "source": "/worldcup.html", "destination": "/categories", "permanent": true }
  ],
  "headers": [
    {
      "source": "/images/categories/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/images/banner/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/flags/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
